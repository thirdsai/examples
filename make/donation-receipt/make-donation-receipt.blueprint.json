                "qs": [],
                "bodyType": "raw",
                "parseResponse": true,
                "timeout": "",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false,
                "contentType": "application/json",
                "data": "{\n  \"template_id\": \"tpl_PASTE_YOUR_TEMPLATE_ID\",\n  \"data\": {\n    \"nonprofit_name\": \"YOUR CHARITY NAME\",\n    \"nonprofit_address\": \"YOUR CHARITY ADDRESS\",\n    \"donor_name\": \"{{2.donor_name}}\",\n    \"donor_email\": \"{{2.donor_email}}\",\n    \"receipt_number\": \"{{2.receipt_number}}\",\n    \"received_on\": \"{{2.received_on}}\",\n    \"amount\": {{2.amount}},\n    \"amount_note\": \"One-off gift by card\",\n    \"designation\": \"The community workshop fund\",\n    \"message\": \"Thank you for helping us keep a warm, open place where people can learn, make things and share their work.\",\n    \"tax_statement\": \"No goods or services were given in exchange for this gift.\",\n    \"contact\": \"YOUR CONTACT EMAIL\",\n    \"footer\": \"YOUR CHARITY REGISTRATION LINE\"\n  }\n}",
                "followAllRedirects": false
            },

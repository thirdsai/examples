            "mapper": {
                "url": "https://thirds.ai/v1/pdf",
                "serializeUrl": false,
                "method": "post",
                "headers": [
                    {
                        "name": "Idempotency-Key",
                        "value": "receipt-{{2.receipt_number}}"
                    }

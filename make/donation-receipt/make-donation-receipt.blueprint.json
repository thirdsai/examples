{
    "name": "Send a branded donation receipt PDF for every Stripe or Tally gift",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {
                "hook": null,
                "maxResults": 1
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0
                },
                "setupValidation": {
                    "version": 1,
                    "configuration": "5c7f4e2155b07d52",
                    "result": {
                        "valid": true,
                        "fields": []
                    }
                },
                "restore": {
                    "parameters": {
                        "hook": {
                            "label": "Add your own webhook",
                            "data": {}
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "hook",
                        "type": "hook:gateway-webhook",
                        "label": "Webhook",
                        "required": true
                    },
                    {
                        "name": "maxResults",
                        "type": "number",
                        "label": "Maximum number of results"
                    }
                ]
            }
        },
        {
            "id": 2,
            "module": "util:SetVariables",
            "version": 1,
            "parameters": {},
            "mapper": {
                "variables": [
                    {
                        "name": "donor_name",
                        "value": "{{1.data.object.customer_details.name}}"
                    },
                    {
                        "name": "donor_email",
                        "value": "{{1.data.object.customer_details.email}}"
                    },
                    {
                        "name": "amount",
                        "value": "{{1.data.object.amount_total / 100}}"
                    },
                    {
                        "name": "received_on",
                        "value": "{{formatDate(parseDate(1.data.object.created; \"X\"); \"YYYY-MM-DD\")}}"
                    },
                    {
                        "name": "receipt_number",
                        "value": "GIFT-{{1.data.object.payment_intent}}"
                    }
                ],
                "scope": "roundtrip"
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                }
            }
        },
        {
            "id": 3,
            "module": "http:ActionSendDataAPIKeyAuth",
            "version": 3,
            "parameters": {
                "auth": null,
                "handleErrors": true,
                "useNewZLibDeCompress": true
